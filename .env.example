# Optional. The default extractive mode needs no credentials and makes no network calls.
# OpenAI sends the question and retrieved runbook text to OpenAI when selected in the UI.
# OPENAI_API_KEY=
# OPENAI_MODEL=your-supported-structured-output-model
# Ollama uses the fixed local endpoint http://127.0.0.1:11434.
# OLLAMA_MODEL=your-locally-installed-model
# ATLAS_DB=data/atlas.sqlite3
